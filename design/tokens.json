  "components": {
    "_about": "What exists, where it lives, and which page shows it. Reuse these; do not make a second one.",
    "story": {
      "css": ".cxm-story, .cx-story-reader",
      "code": "ext/cx-story.jsx, ext/cxm-today.jsx",
      "note": "ring, progress bars, label, big line, figure, quote, support line, source; background is the accent"
    },
    "ring": {
      "css": ".cxm-ring, .cx-stories-ring",
      "code": "ext/cxm-today.jsx"
    },
    "number-pad": {
      "css": ".cxm-keys, .cxm-kdisp",
      "code": "ext/cxm-ballot.jsx, ext/cx-levies.jsx"
    },
    "read-more": {
      "css": ".lv-more-story, .cxm-drop",
      "code": "ext/cx-levies.jsx, ext/cxm-core.jsx"
    },
    "card": {
      "css": ".cxm-card, .cxm-tile",
      "code": "ext/cxm-*.jsx"
    },
    "accent-card": {
      "css": ".cxm-keycard, .lv-tile",
      "code": "ext/cxm-ballot.jsx, ext/cx-levies.jsx"
    },
    "sheet": {
      "css": ".cxm-sheet",
      "code": "ext/cxm-core.jsx",
      "note": "pulls down to close"
    },
    "button": {
      "css": ".cxm-btn, .cxm-btn2, .cx-story-btn",
      "code": "ext/cxm-core.jsx"
    },
    "notice": {
      "css": ".cx-notice, .cxm-notice",
      "code": "ext/cx-i18n.jsx, ext/cxm-core.jsx"
    },
    "chip": {
      "css": ".lv-chip, .sp-chip",
      "code": "ext/cx-levies.jsx, ext/cx-seat.jsx"
    },
    "header-action": {
      "css": ".cxm-top-actions button, .atlas-header-actions button",
      "code": "ext/cxm-core.jsx, build.py"
    },
    "profile-page": {
      "css": ".sp",
      "code": "ext/cx-seat.jsx"
    },
    "district-finder": {
      "css": ".dist-body, .dist-card, .cxm-story-districts",
      "code": "ext/cx-districts.jsx, ext/cxm-ballot.jsx",
      "note": "blue like the stories; big rows; the address is matched on the device and never saved or sent"
    },
    "profile-card": {
      "css": ".cxm-profile, .cxm-prof-head, .cxm-prof-actions, .cxm-prof-nav, .cxm-strip",
      "code": "ext/cxm-people.jsx (CxmProfileCard, CxmProfileActions, CxmProfileNav, CxmProfileStrip), ext/cxm-federal.jsx",
      "note": "every person's profile has one shape: face, kicker, name, role line, tiles, then Full Story, Profile, Write {first name}, then a one-line note. Cleveland and Federal both use it; a new tab reuses it"
    },
    "folder-tabs": {
      "css": ".cxm-folders",
      "code": "ext/cxm-people.jsx (CxmFolders)",
      "note": "tabs at the top of People (Cleveland, Federal); arrow keys move between them; room for more"
    },
    "federal-index": {
      "css": ".us-doors, .us-door, .us-ring, .us-groups, .us-list",
      "code": "ext/cx-us.jsx (CX_UsDoors), ext/cx-us-model.jsx",
      "note": "five ways into the federal government; the ring holds a count, never a score"
    },
    "federal-sky": {
      "css": ".us-sky, .us-tabs, .us-motion, .us-actions, .us-solo",
      "code": "ext/cx-us.jsx (CX_UsGraph), ext/cx-us-model.jsx (cxUsPlace, cxUsSolo, cxUsStep)",
      "note": "folder-tab views; the big map fills the page; Still, Calm, Live motion with a home position for every node"
    },
    "person-face": {
      "css": ".cxm-fed-av, .us-who",
      "code": "ext/cx-us.jsx (CxFace)",
      "note": "a round portrait over the person's initials; a missing photo leaves the initials; used on Federal profiles, the strip, the Index, and the Sky side panel"
    },
    "city-hall-front-page": {
      "css": ".mt, .mt-lead, .mt-item, .mt-strip, .mt-small, .mt-chip, .mt-card",
      "code": "ext/cx-meetings.jsx",
      "note": "a lead tile (the next Council meeting), a short strip for the rest of the week, what was just decided, and earlier meetings folded by month; every item opens its legislation record"
    },
    "section-banner": {
      "css": ".bn, .bn-art, .bn-copy, .bn-f1, .bn-f2, .bn-f3, .bn-f4, .bn-f5, .bn-f6x, .bn-f7",
      "code": "ext/cxm-banner.jsx",
      "note": "an illustrated header for each chapter of Today (What's new, At City Hall, City Hall receipts, Close to home); original drawings in the style's own colors through variables, no text inside, hidden from screen readers, motion stops for reduced-motion"
    }
  },
